<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="mofi_defs" targetNamespace="http://bpmn.io/schema/bpmn" exporter="wireframe-rea" exporterVersion="1.0">
  <bpmn:collaboration id="mofi_collab">
    <bpmn:participant id="mofi_pool" name="Proses Pengajuan Pembiayaan MOFI (RO App)" processRef="mofi_process" />
  </bpmn:collaboration>
  <bpmn:process id="mofi_process" isExecutable="false">
    <bpmn:laneSet id="mofi_laneset">
        <bpmn:lane id="mofi_lane0" name="Customer">
          <bpmn:flowNodeRef>mofi_konfirm</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>mofi_g_cust</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>mofi_e_batal</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>mofi_ttd</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="mofi_lane1" name="RO (Relationship Officer)">
          <bpmn:flowNodeRef>mofi_s</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>mofi_login</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>mofi_g_src</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>mofi_review</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>mofi_buat</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>mofi_g_src_m</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>mofi_kirim</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>mofi_resend</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>mofi_lengkapi</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>mofi_bpkb</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>mofi_pantau</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>mofi_e_live</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="mofi_lane2" name="Sistem MOFI">
          <bpmn:flowNodeRef>mofi_consent</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>mofi_idcheck</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>mofi_kontrak</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>mofi_cair</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="mofi_lane3" name="Tim Kredit / Cabang (CA, BM)">
          <bpmn:flowNodeRef>mofi_analisis</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>mofi_g_hasil</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>mofi_deviasi</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>mofi_e_tolak</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>mofi_verif</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>mofi_g_to</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>mofi_dok_to</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>mofi_cek_akhir</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>mofi_g_to_m</bpmn:flowNodeRef>
        </bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="mofi_s" name="Ada calon customer"><bpmn:outgoing>mofi_f0</bpmn:outgoing></bpmn:startEvent>
      <bpmn:userTask id="mofi_login" name="Login nomor HP + OTP"><bpmn:incoming>mofi_f0</bpmn:incoming><bpmn:outgoing>mofi_f1</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="mofi_g_src" name="Sumber pengajuan?"><bpmn:incoming>mofi_f1</bpmn:incoming><bpmn:outgoing>mofi_f2</bpmn:outgoing><bpmn:outgoing>mofi_f3</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="mofi_review" name="Review leads dari DT / Agen"><bpmn:incoming>mofi_f2</bpmn:incoming><bpmn:outgoing>mofi_f4</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="mofi_buat" name="Buat pengajuan: SKU, paket, data customer"><bpmn:incoming>mofi_f3</bpmn:incoming><bpmn:outgoing>mofi_f5</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="mofi_g_src_m"><bpmn:incoming>mofi_f4</bpmn:incoming><bpmn:incoming>mofi_f5</bpmn:incoming><bpmn:outgoing>mofi_f6</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="mofi_kirim" name="Review ringkasan, kirim pengajuan"><bpmn:incoming>mofi_f6</bpmn:incoming><bpmn:outgoing>mofi_f7</bpmn:outgoing></bpmn:userTask>
      <bpmn:serviceTask id="mofi_consent" name="Kirim permintaan konfirmasi ke customer"><bpmn:incoming>mofi_f7</bpmn:incoming><bpmn:incoming>mofi_f11</bpmn:incoming><bpmn:outgoing>mofi_f8</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:manualTask id="mofi_konfirm" name="Konfirmasi pengajuan"><bpmn:incoming>mofi_f8</bpmn:incoming><bpmn:outgoing>mofi_f9</bpmn:outgoing></bpmn:manualTask>
      <bpmn:exclusiveGateway id="mofi_g_cust" name="Respons?"><bpmn:incoming>mofi_f9</bpmn:incoming><bpmn:outgoing>mofi_f10</bpmn:outgoing><bpmn:outgoing>mofi_f12</bpmn:outgoing><bpmn:outgoing>mofi_f13</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="mofi_resend" name="Kirim ulang / ganti nomor HP"><bpmn:incoming>mofi_f10</bpmn:incoming><bpmn:outgoing>mofi_f11</bpmn:outgoing></bpmn:userTask>
      <bpmn:endEvent id="mofi_e_batal" name="Dibatalkan"><bpmn:incoming>mofi_f12</bpmn:incoming></bpmn:endEvent>
      <bpmn:serviceTask id="mofi_idcheck" name="Pengecekan identitas (first block)"><bpmn:incoming>mofi_f13</bpmn:incoming><bpmn:outgoing>mofi_f14</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:userTask id="mofi_analisis" name="Analisis kredit oleh CA"><bpmn:incoming>mofi_f14</bpmn:incoming><bpmn:incoming>mofi_f17</bpmn:incoming><bpmn:outgoing>mofi_f15</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="mofi_g_hasil" name="Hasil analisis?"><bpmn:incoming>mofi_f15</bpmn:incoming><bpmn:outgoing>mofi_f16</bpmn:outgoing><bpmn:outgoing>mofi_f18</bpmn:outgoing><bpmn:outgoing>mofi_f19</bpmn:outgoing><bpmn:outgoing>mofi_f20</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="mofi_lengkapi" name="Lengkapi data tambahan"><bpmn:incoming>mofi_f16</bpmn:incoming><bpmn:outgoing>mofi_f17</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="mofi_deviasi" name="Pengajuan deviasi"><bpmn:incoming>mofi_f18</bpmn:incoming><bpmn:outgoing>mofi_f21</bpmn:outgoing></bpmn:userTask>
      <bpmn:endEvent id="mofi_e_tolak" name="Ditolak"><bpmn:incoming>mofi_f19</bpmn:incoming></bpmn:endEvent>
      <bpmn:serviceTask id="mofi_kontrak" name="Kirim perjanjian pembiayaan"><bpmn:incoming>mofi_f20</bpmn:incoming><bpmn:incoming>mofi_f21</bpmn:incoming><bpmn:outgoing>mofi_f22</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:manualTask id="mofi_ttd" name="Tanda tangan perjanjian"><bpmn:incoming>mofi_f22</bpmn:incoming><bpmn:outgoing>mofi_f23</bpmn:outgoing></bpmn:manualTask>
      <bpmn:userTask id="mofi_verif" name="Verifikasi akhir"><bpmn:incoming>mofi_f23</bpmn:incoming><bpmn:outgoing>mofi_f24</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="mofi_g_to" name="Take over?"><bpmn:incoming>mofi_f24</bpmn:incoming><bpmn:outgoing>mofi_f25</bpmn:outgoing><bpmn:outgoing>mofi_f26</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="mofi_dok_to" name="Tunggu dokumen take over dari BM"><bpmn:incoming>mofi_f25</bpmn:incoming><bpmn:outgoing>mofi_f27</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="mofi_cek_akhir" name="Pengecekan akhir sebelum Go Live"><bpmn:incoming>mofi_f26</bpmn:incoming><bpmn:outgoing>mofi_f29</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="mofi_bpkb" name="Konfirmasi penyerahan BPKB ke cabang"><bpmn:incoming>mofi_f27</bpmn:incoming><bpmn:outgoing>mofi_f28</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="mofi_g_to_m"><bpmn:incoming>mofi_f28</bpmn:incoming><bpmn:incoming>mofi_f29</bpmn:incoming><bpmn:outgoing>mofi_f30</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="mofi_cair" name="Pencairan dana (Go Live)"><bpmn:incoming>mofi_f30</bpmn:incoming><bpmn:outgoing>mofi_f31</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:userTask id="mofi_pantau" name="Pantau status, unduh kontrak"><bpmn:incoming>mofi_f31</bpmn:incoming><bpmn:outgoing>mofi_f32</bpmn:outgoing></bpmn:userTask>
      <bpmn:endEvent id="mofi_e_live" name="Go Live"><bpmn:incoming>mofi_f32</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="mofi_f0" sourceRef="mofi_s" targetRef="mofi_login" />
      <bpmn:sequenceFlow id="mofi_f1" sourceRef="mofi_login" targetRef="mofi_g_src" />
      <bpmn:sequenceFlow id="mofi_f2" sourceRef="mofi_g_src" targetRef="mofi_review" name="Leads DT" />
      <bpmn:sequenceFlow id="mofi_f3" sourceRef="mofi_g_src" targetRef="mofi_buat" name="Buat sendiri" />
      <bpmn:sequenceFlow id="mofi_f4" sourceRef="mofi_review" targetRef="mofi_g_src_m" />
      <bpmn:sequenceFlow id="mofi_f5" sourceRef="mofi_buat" targetRef="mofi_g_src_m" />
      <bpmn:sequenceFlow id="mofi_f6" sourceRef="mofi_g_src_m" targetRef="mofi_kirim" />
      <bpmn:sequenceFlow id="mofi_f7" sourceRef="mofi_kirim" targetRef="mofi_consent" />
      <bpmn:sequenceFlow id="mofi_f8" sourceRef="mofi_consent" targetRef="mofi_konfirm" />
      <bpmn:sequenceFlow id="mofi_f9" sourceRef="mofi_konfirm" targetRef="mofi_g_cust" />
      <bpmn:sequenceFlow id="mofi_f10" sourceRef="mofi_g_cust" targetRef="mofi_resend" name="Tidak merespons" />
      <bpmn:sequenceFlow id="mofi_f11" sourceRef="mofi_resend" targetRef="mofi_consent" />
      <bpmn:sequenceFlow id="mofi_f12" sourceRef="mofi_g_cust" targetRef="mofi_e_batal" name="Menolak" />
      <bpmn:sequenceFlow id="mofi_f13" sourceRef="mofi_g_cust" targetRef="mofi_idcheck" name="Setuju" />
      <bpmn:sequenceFlow id="mofi_f14" sourceRef="mofi_idcheck" targetRef="mofi_analisis" />
      <bpmn:sequenceFlow id="mofi_f15" sourceRef="mofi_analisis" targetRef="mofi_g_hasil" />
      <bpmn:sequenceFlow id="mofi_f16" sourceRef="mofi_g_hasil" targetRef="mofi_lengkapi" name="Data kurang" />
      <bpmn:sequenceFlow id="mofi_f17" sourceRef="mofi_lengkapi" targetRef="mofi_analisis" />
      <bpmn:sequenceFlow id="mofi_f18" sourceRef="mofi_g_hasil" targetRef="mofi_deviasi" name="Deviasi" />
      <bpmn:sequenceFlow id="mofi_f19" sourceRef="mofi_g_hasil" targetRef="mofi_e_tolak" name="Ditolak" />
      <bpmn:sequenceFlow id="mofi_f20" sourceRef="mofi_g_hasil" targetRef="mofi_kontrak" name="Disetujui" />
      <bpmn:sequenceFlow id="mofi_f21" sourceRef="mofi_deviasi" targetRef="mofi_kontrak" />
      <bpmn:sequenceFlow id="mofi_f22" sourceRef="mofi_kontrak" targetRef="mofi_ttd" />
      <bpmn:sequenceFlow id="mofi_f23" sourceRef="mofi_ttd" targetRef="mofi_verif" />
      <bpmn:sequenceFlow id="mofi_f24" sourceRef="mofi_verif" targetRef="mofi_g_to" />
      <bpmn:sequenceFlow id="mofi_f25" sourceRef="mofi_g_to" targetRef="mofi_dok_to" name="Ya" />
      <bpmn:sequenceFlow id="mofi_f26" sourceRef="mofi_g_to" targetRef="mofi_cek_akhir" name="Tidak" />
      <bpmn:sequenceFlow id="mofi_f27" sourceRef="mofi_dok_to" targetRef="mofi_bpkb" />
      <bpmn:sequenceFlow id="mofi_f28" sourceRef="mofi_bpkb" targetRef="mofi_g_to_m" />
      <bpmn:sequenceFlow id="mofi_f29" sourceRef="mofi_cek_akhir" targetRef="mofi_g_to_m" />
      <bpmn:sequenceFlow id="mofi_f30" sourceRef="mofi_g_to_m" targetRef="mofi_cair" />
      <bpmn:sequenceFlow id="mofi_f31" sourceRef="mofi_cair" targetRef="mofi_pantau" />
      <bpmn:sequenceFlow id="mofi_f32" sourceRef="mofi_pantau" targetRef="mofi_e_live" />
  </bpmn:process>
