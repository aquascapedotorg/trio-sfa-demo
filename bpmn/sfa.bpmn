<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="sfa_defs" targetNamespace="http://bpmn.io/schema/bpmn" exporter="wireframe-rea" exporterVersion="1.0">
  <bpmn:collaboration id="sfa_collab">
    <bpmn:participant id="sfa_pool" name="Proses Kunjungan Harian Sales (NNA SFA)" processRef="sfa_process" />
  </bpmn:collaboration>
  <bpmn:process id="sfa_process" isExecutable="false">
    <bpmn:laneSet id="sfa_laneset">
        <bpmn:lane id="sfa_lane0" name="Pelanggan (WS / RRO)">
          <bpmn:flowNodeRef>sfa_faktur</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="sfa_lane1" name="Sales">
          <bpmn:flowNodeRef>sfa_s</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>sfa_login</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>sfa_dash</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>sfa_siap</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>sfa_g_rute</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>sfa_dalam</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>sfa_luar</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>sfa_g_rute_m</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>sfa_checkin</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>sfa_stok</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>sfa_g_akt</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>sfa_retur</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>sfa_tagih</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>sfa_jual</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>sfa_g_akt_m</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>sfa_checkout</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>sfa_g_lagi</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>sfa_kas</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>sfa_akhir</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="sfa_lane2" name="Sistem SFA / DMS">
          <bpmn:flowNodeRef>sfa_sync</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>sfa_catat</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>sfa_push</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>sfa_e</bpmn:flowNodeRef>
        </bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="sfa_s" name="Mulai hari kerja"><bpmn:outgoing>sfa_f0</bpmn:outgoing></bpmn:startEvent>
      <bpmn:userTask id="sfa_login" name="Login"><bpmn:incoming>sfa_f0</bpmn:incoming><bpmn:outgoing>sfa_f1</bpmn:outgoing></bpmn:userTask>
      <bpmn:serviceTask id="sfa_sync" name="Sync rute, pelanggan, stok, harga"><bpmn:incoming>sfa_f1</bpmn:incoming><bpmn:outgoing>sfa_f2</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:userTask id="sfa_dash" name="Baca berita harian, cek dashboard"><bpmn:incoming>sfa_f2</bpmn:incoming><bpmn:outgoing>sfa_f3</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="sfa_siap" name="Persiapan: cek rute dan stok"><bpmn:incoming>sfa_f3</bpmn:incoming><bpmn:outgoing>sfa_f4</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="sfa_g_rute" name="Dalam rute?"><bpmn:incoming>sfa_f4</bpmn:incoming><bpmn:incoming>sfa_f22</bpmn:incoming><bpmn:outgoing>sfa_f5</bpmn:outgoing><bpmn:outgoing>sfa_f6</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="sfa_dalam" name="Pilih pelanggan dari call plan"><bpmn:incoming>sfa_f5</bpmn:incoming><bpmn:outgoing>sfa_f7</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="sfa_luar" name="Pilih luar rute / daftar RRO baru"><bpmn:incoming>sfa_f6</bpmn:incoming><bpmn:outgoing>sfa_f8</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="sfa_g_rute_m"><bpmn:incoming>sfa_f7</bpmn:incoming><bpmn:incoming>sfa_f8</bpmn:incoming><bpmn:outgoing>sfa_f9</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="sfa_checkin" name="Check in di lokasi"><bpmn:incoming>sfa_f9</bpmn:incoming><bpmn:outgoing>sfa_f10</bpmn:outgoing></bpmn:userTask>
      <bpmn:serviceTask id="sfa_catat" name="Simpan lokasi dan waktu kunjungan"><bpmn:incoming>sfa_f10</bpmn:incoming><bpmn:outgoing>sfa_f11</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:userTask id="sfa_stok" name="Lihat info, input sisa stok pelanggan"><bpmn:incoming>sfa_f11</bpmn:incoming><bpmn:outgoing>sfa_f12</bpmn:outgoing></bpmn:userTask>
      <bpmn:inclusiveGateway id="sfa_g_akt" name="Aktivitas"><bpmn:incoming>sfa_f12</bpmn:incoming><bpmn:outgoing>sfa_f13</bpmn:outgoing><bpmn:outgoing>sfa_f14</bpmn:outgoing><bpmn:outgoing>sfa_f15</bpmn:outgoing></bpmn:inclusiveGateway>
      <bpmn:userTask id="sfa_retur" name="Retur"><bpmn:incoming>sfa_f13</bpmn:incoming><bpmn:outgoing>sfa_f16</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="sfa_tagih" name="Penagihan"><bpmn:incoming>sfa_f14</bpmn:incoming><bpmn:outgoing>sfa_f17</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="sfa_jual" name="Penjualan"><bpmn:incoming>sfa_f15</bpmn:incoming><bpmn:outgoing>sfa_f18</bpmn:outgoing></bpmn:userTask>
      <bpmn:inclusiveGateway id="sfa_g_akt_m"><bpmn:incoming>sfa_f16</bpmn:incoming><bpmn:incoming>sfa_f17</bpmn:incoming><bpmn:incoming>sfa_f18</bpmn:incoming><bpmn:outgoing>sfa_f19</bpmn:outgoing></bpmn:inclusiveGateway>
      <bpmn:manualTask id="sfa_faktur" name="Terima faktur, tanda tangan"><bpmn:incoming>sfa_f19</bpmn:incoming><bpmn:outgoing>sfa_f20</bpmn:outgoing></bpmn:manualTask>
      <bpmn:userTask id="sfa_checkout" name="Check out"><bpmn:incoming>sfa_f20</bpmn:incoming><bpmn:outgoing>sfa_f21</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="sfa_g_lagi" name="Pelanggan lain?"><bpmn:incoming>sfa_f21</bpmn:incoming><bpmn:outgoing>sfa_f22</bpmn:outgoing><bpmn:outgoing>sfa_f23</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="sfa_kas" name="Input biaya operasional"><bpmn:incoming>sfa_f23</bpmn:incoming><bpmn:outgoing>sfa_f24</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="sfa_akhir" name="Akhiri perjalanan, kembalikan stok"><bpmn:incoming>sfa_f24</bpmn:incoming><bpmn:outgoing>sfa_f25</bpmn:outgoing></bpmn:userTask>
      <bpmn:serviceTask id="sfa_push" name="Sync transaksi ke DMS"><bpmn:incoming>sfa_f25</bpmn:incoming><bpmn:outgoing>sfa_f26</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="sfa_e" name="Hari selesai"><bpmn:incoming>sfa_f26</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="sfa_f0" sourceRef="sfa_s" targetRef="sfa_login" />
      <bpmn:sequenceFlow id="sfa_f1" sourceRef="sfa_login" targetRef="sfa_sync" />
      <bpmn:sequenceFlow id="sfa_f2" sourceRef="sfa_sync" targetRef="sfa_dash" />
      <bpmn:sequenceFlow id="sfa_f3" sourceRef="sfa_dash" targetRef="sfa_siap" />
      <bpmn:sequenceFlow id="sfa_f4" sourceRef="sfa_siap" targetRef="sfa_g_rute" />
      <bpmn:sequenceFlow id="sfa_f5" sourceRef="sfa_g_rute" targetRef="sfa_dalam" name="Ya" />
      <bpmn:sequenceFlow id="sfa_f6" sourceRef="sfa_g_rute" targetRef="sfa_luar" name="Tidak" />
      <bpmn:sequenceFlow id="sfa_f7" sourceRef="sfa_dalam" targetRef="sfa_g_rute_m" />
      <bpmn:sequenceFlow id="sfa_f8" sourceRef="sfa_luar" targetRef="sfa_g_rute_m" />
      <bpmn:sequenceFlow id="sfa_f9" sourceRef="sfa_g_rute_m" targetRef="sfa_checkin" />
      <bpmn:sequenceFlow id="sfa_f10" sourceRef="sfa_checkin" targetRef="sfa_catat" />
      <bpmn:sequenceFlow id="sfa_f11" sourceRef="sfa_catat" targetRef="sfa_stok" />
      <bpmn:sequenceFlow id="sfa_f12" sourceRef="sfa_stok" targetRef="sfa_g_akt" />
      <bpmn:sequenceFlow id="sfa_f13" sourceRef="sfa_g_akt" targetRef="sfa_retur" />
      <bpmn:sequenceFlow id="sfa_f14" sourceRef="sfa_g_akt" targetRef="sfa_tagih" />
      <bpmn:sequenceFlow id="sfa_f15" sourceRef="sfa_g_akt" targetRef="sfa_jual" />
      <bpmn:sequenceFlow id="sfa_f16" sourceRef="sfa_retur" targetRef="sfa_g_akt_m" />
      <bpmn:sequenceFlow id="sfa_f17" sourceRef="sfa_tagih" targetRef="sfa_g_akt_m" />
      <bpmn:sequenceFlow id="sfa_f18" sourceRef="sfa_jual" targetRef="sfa_g_akt_m" />
      <bpmn:sequenceFlow id="sfa_f19" sourceRef="sfa_g_akt_m" targetRef="sfa_faktur" />
      <bpmn:sequenceFlow id="sfa_f20" sourceRef="sfa_faktur" targetRef="sfa_checkout" />
      <bpmn:sequenceFlow id="sfa_f21" sourceRef="sfa_checkout" targetRef="sfa_g_lagi" />
      <bpmn:sequenceFlow id="sfa_f22" sourceRef="sfa_g_lagi" targetRef="sfa_g_rute" name="Ya" />
      <bpmn:sequenceFlow id="sfa_f23" sourceRef="sfa_g_lagi" targetRef="sfa_kas" name="Tidak" />
      <bpmn:sequenceFlow id="sfa_f24" sourceRef="sfa_kas" targetRef="sfa_akhir" />
      <bpmn:sequenceFlow id="sfa_f25" sourceRef="sfa_akhir" targetRef="sfa_push" />
      <bpmn:sequenceFlow id="sfa_f26" sourceRef="sfa_push" targetRef="sfa_e" />
  </bpmn:process>
