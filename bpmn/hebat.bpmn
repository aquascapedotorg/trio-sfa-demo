<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="hebat_defs" targetNamespace="http://bpmn.io/schema/bpmn" exporter="wireframe-rea" exporterVersion="1.0">
  <bpmn:collaboration id="hebat_collab">
    <bpmn:participant id="hebat_pool" name="Proses Kunjungan Outlet (BAT HeBAT)" processRef="hebat_process" />
  </bpmn:collaboration>
  <bpmn:process id="hebat_process" isExecutable="false">
    <bpmn:laneSet id="hebat_laneset">
        <bpmn:lane id="hebat_lane0" name="Outlet">
          <bpmn:flowNodeRef>hebat_setuju</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="hebat_lane1" name="Field Force">
          <bpmn:flowNodeRef>hebat_s</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>hebat_signin</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>hebat_home</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>hebat_absen</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>hebat_rute</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>hebat_pilih</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>hebat_checkin</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>hebat_g_akt</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>hebat_count</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>hebat_order</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>hebat_edu</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>hebat_merch</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>hebat_g_akt_m</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>hebat_selesai</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>hebat_g_lagi</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>hebat_pulang</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="hebat_lane2" name="Sistem HeBAT">
          <bpmn:flowNodeRef>hebat_catat_absen</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>hebat_progres</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="hebat_lane3" name="Supervisor">
          <bpmn:flowNodeRef>hebat_review</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>hebat_e</bpmn:flowNodeRef>
        </bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="hebat_s" name="Mulai hari kerja"><bpmn:outgoing>hebat_f0</bpmn:outgoing></bpmn:startEvent>
      <bpmn:userTask id="hebat_signin" name="Sign in"><bpmn:incoming>hebat_f0</bpmn:incoming><bpmn:outgoing>hebat_f1</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="hebat_home" name="Lihat dashboard dan pengingat absen"><bpmn:incoming>hebat_f1</bpmn:incoming><bpmn:outgoing>hebat_f2</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="hebat_absen" name="Absen masuk"><bpmn:incoming>hebat_f2</bpmn:incoming><bpmn:outgoing>hebat_f3</bpmn:outgoing></bpmn:userTask>
      <bpmn:serviceTask id="hebat_catat_absen" name="Catat kehadiran"><bpmn:incoming>hebat_f3</bpmn:incoming><bpmn:outgoing>hebat_f4</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:userTask id="hebat_rute" name="Lihat rute hari ini"><bpmn:incoming>hebat_f4</bpmn:incoming><bpmn:outgoing>hebat_f5</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="hebat_pilih" name="Pilih outlet dari daftar visit"><bpmn:incoming>hebat_f5</bpmn:incoming><bpmn:incoming>hebat_f20</bpmn:incoming><bpmn:outgoing>hebat_f6</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="hebat_checkin" name="Buka lokasi outlet, check in"><bpmn:incoming>hebat_f6</bpmn:incoming><bpmn:outgoing>hebat_f7</bpmn:outgoing></bpmn:userTask>
      <bpmn:inclusiveGateway id="hebat_g_akt" name="Aktivitas visit"><bpmn:incoming>hebat_f7</bpmn:incoming><bpmn:outgoing>hebat_f8</bpmn:outgoing><bpmn:outgoing>hebat_f9</bpmn:outgoing><bpmn:outgoing>hebat_f10</bpmn:outgoing><bpmn:outgoing>hebat_f11</bpmn:outgoing></bpmn:inclusiveGateway>
      <bpmn:userTask id="hebat_count" name="Count stock"><bpmn:incoming>hebat_f8</bpmn:incoming><bpmn:outgoing>hebat_f12</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="hebat_order" name="Order capture"><bpmn:incoming>hebat_f9</bpmn:incoming><bpmn:outgoing>hebat_f13</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="hebat_edu" name="Education"><bpmn:incoming>hebat_f10</bpmn:incoming><bpmn:outgoing>hebat_f14</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="hebat_merch" name="Merchandise + foto"><bpmn:incoming>hebat_f11</bpmn:incoming><bpmn:outgoing>hebat_f15</bpmn:outgoing></bpmn:userTask>
      <bpmn:inclusiveGateway id="hebat_g_akt_m"><bpmn:incoming>hebat_f12</bpmn:incoming><bpmn:incoming>hebat_f13</bpmn:incoming><bpmn:incoming>hebat_f14</bpmn:incoming><bpmn:incoming>hebat_f15</bpmn:incoming><bpmn:outgoing>hebat_f16</bpmn:outgoing></bpmn:inclusiveGateway>
      <bpmn:manualTask id="hebat_setuju" name="Konfirmasi order"><bpmn:incoming>hebat_f16</bpmn:incoming><bpmn:outgoing>hebat_f17</bpmn:outgoing></bpmn:manualTask>
      <bpmn:userTask id="hebat_selesai" name="Selesaikan visit"><bpmn:incoming>hebat_f17</bpmn:incoming><bpmn:outgoing>hebat_f18</bpmn:outgoing></bpmn:userTask>
      <bpmn:serviceTask id="hebat_progres" name="Update progres visit"><bpmn:incoming>hebat_f18</bpmn:incoming><bpmn:outgoing>hebat_f19</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="hebat_g_lagi" name="Outlet lain?"><bpmn:incoming>hebat_f19</bpmn:incoming><bpmn:outgoing>hebat_f20</bpmn:outgoing><bpmn:outgoing>hebat_f21</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="hebat_pulang" name="Absen pulang"><bpmn:incoming>hebat_f21</bpmn:incoming><bpmn:outgoing>hebat_f22</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="hebat_review" name="Review hasil visit dan absensi"><bpmn:incoming>hebat_f22</bpmn:incoming><bpmn:outgoing>hebat_f23</bpmn:outgoing></bpmn:userTask>
      <bpmn:endEvent id="hebat_e" name="Hari selesai"><bpmn:incoming>hebat_f23</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="hebat_f0" sourceRef="hebat_s" targetRef="hebat_signin" />
      <bpmn:sequenceFlow id="hebat_f1" sourceRef="hebat_signin" targetRef="hebat_home" />
      <bpmn:sequenceFlow id="hebat_f2" sourceRef="hebat_home" targetRef="hebat_absen" />
      <bpmn:sequenceFlow id="hebat_f3" sourceRef="hebat_absen" targetRef="hebat_catat_absen" />
      <bpmn:sequenceFlow id="hebat_f4" sourceRef="hebat_catat_absen" targetRef="hebat_rute" />
      <bpmn:sequenceFlow id="hebat_f5" sourceRef="hebat_rute" targetRef="hebat_pilih" />
      <bpmn:sequenceFlow id="hebat_f6" sourceRef="hebat_pilih" targetRef="hebat_checkin" />
      <bpmn:sequenceFlow id="hebat_f7" sourceRef="hebat_checkin" targetRef="hebat_g_akt" />
      <bpmn:sequenceFlow id="hebat_f8" sourceRef="hebat_g_akt" targetRef="hebat_count" />
      <bpmn:sequenceFlow id="hebat_f9" sourceRef="hebat_g_akt" targetRef="hebat_order" />
      <bpmn:sequenceFlow id="hebat_f10" sourceRef="hebat_g_akt" targetRef="hebat_edu" />
      <bpmn:sequenceFlow id="hebat_f11" sourceRef="hebat_g_akt" targetRef="hebat_merch" />
      <bpmn:sequenceFlow id="hebat_f12" sourceRef="hebat_count" targetRef="hebat_g_akt_m" />
      <bpmn:sequenceFlow id="hebat_f13" sourceRef="hebat_order" targetRef="hebat_g_akt_m" />
      <bpmn:sequenceFlow id="hebat_f14" sourceRef="hebat_edu" targetRef="hebat_g_akt_m" />
      <bpmn:sequenceFlow id="hebat_f15" sourceRef="hebat_merch" targetRef="hebat_g_akt_m" />
      <bpmn:sequenceFlow id="hebat_f16" sourceRef="hebat_g_akt_m" targetRef="hebat_setuju" />
      <bpmn:sequenceFlow id="hebat_f17" sourceRef="hebat_setuju" targetRef="hebat_selesai" />
      <bpmn:sequenceFlow id="hebat_f18" sourceRef="hebat_selesai" targetRef="hebat_progres" />
      <bpmn:sequenceFlow id="hebat_f19" sourceRef="hebat_progres" targetRef="hebat_g_lagi" />
      <bpmn:sequenceFlow id="hebat_f20" sourceRef="hebat_g_lagi" targetRef="hebat_pilih" name="Ya" />
      <bpmn:sequenceFlow id="hebat_f21" sourceRef="hebat_g_lagi" targetRef="hebat_pulang" name="Tidak" />
      <bpmn:sequenceFlow id="hebat_f22" sourceRef="hebat_pulang" targetRef="hebat_review" />
      <bpmn:sequenceFlow id="hebat_f23" sourceRef="hebat_review" targetRef="hebat_e" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="hebat_diagram">
    <bpmndi:BPMNPlane id="hebat_plane" bpmnElement="hebat_collab">
      <bpmndi:BPMNShape id="hebat_pool_di" bpmnElement="hebat_pool" isHorizontal="true"><dc:Bounds x="0" y="0" width="2820" height="800" /></bpmndi:BPMNShape>
